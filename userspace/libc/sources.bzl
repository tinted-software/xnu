# These are compile inputs, not a system SDK substitute. Keep the compatibility
# overlay before libc's cdefs wrapper, and the real XNU cdefs after that wrapper.
# Per-file PBXBuildFile flags are appended last so their -U/-D overrides win.
#
# LIBC_BASE_FLAGS and LIBC_INCLUDE_FLAGS are also used by targets that compile
# libc-side support sources outside the archives (libsystem_trace_compat), so
# that a source built against libc's headers sees libc's feature defines.
LIBC_BASE_FLAGS = [
        "-target", target_triple(),
        "-nostdlibinc",
        "-std=gnu11",
        "-Os",
        "-fblocks",
        "-fdollars-in-identifiers",
        "-fno-common",
        "-fverbose-asm",
        "-Wall",
        "-Werror",
        "-Werror=implicit-function-declaration",
        "-Wno-error=shorten-64-to-32",
        "-Wno-error=incompatible-pointer-types-discards-qualifiers",
        "-Wno-nullability-completeness",
        "-Wno-error=deprecated",
        "-Wno-error=availability",
        "-Wno-error=unused-but-set-variable",
        "-Wno-error=unused-variable",
        "-Wno-availability",
        "-D__LIBC__",
        # Full Darwin API surface (strlcpy and friends), as libc is built with.
        # Valued form: sources that define _DARWIN_C_SOURCE themselves (e.g.
        # sys/getgroups.c) must not trip -Wmacro-redefined.
        "-D_DARWIN_C_SOURCE",
        # The SDK mach_time.h exposes mach_time_private.h unconditionally; this
        # tree gates it on PRIVATE.
        "-DPRIVATE",
        "-D__DARWIN_UNIX03=1",
        "-D__DARWIN_64_BIT_INO_T=1",
        "-D__DARWIN_NON_CANCELABLE=1",
        "-D__DARWIN_VERS_1050=1",
        # Single modern macOS ABI, as the generated libc-features.h requires.
        "-D__DARWIN_ONLY_VERS_1050=1",
        "-D__DARWIN_ONLY_UNIX_CONFORMANCE=1",
        "-D__DARWIN_ONLY_64_BIT_INO_T=1",
        "-D_FORTIFY_SOURCE=0",
        "-DTARGET_OS_EXCLAVECORE=0",
        "-DTARGET_OS_EXCLAVEKIT=0",
]

def libc_sources(archive):
    flags = list(LIBC_BASE_FLAGS)
    if archive == "FreeBSD":
        flags += [
            "-include", "bsd/sys/cdefs.h",
            "-include", "userspace/libc/fbsdcompat/_fbsd_compat_.h",
            "-Iuserspace/libc/gdtoa",
            "-Iuserspace/libc/gdtoa/FreeBSD",
        ]
    elif archive == "NetBSD":
        flags += [
            "-include", "userspace/libc/nbsdcompat/_nbsd_compat_.h",
            "-Iuserspace/libc/nbsdcompat",
        ]
    elif archive == "TRE":
        flags += [
            "-DHAVE_CONFIG_H",
            "-Iuserspace/libc/regex/TRE",
            "-Iuserspace/libc/regex/FreeBSD",
        ]
    elif archive in LIBC_VARIANT_FLAGS:
        flags += [
            "-include", "bsd/sys/cdefs.h",
            "-Iuserspace/libc/gdtoa",
            "-Iuserspace/libc/gdtoa/FreeBSD",
        ]
    if archive in LIBC_VARIANT_FLAGS:
        # Replace the local include directory, rather than adding the original
        # before it: include_next in sys/cdefs.h must reach the actual SDK cdefs.
        flags += ["-I$(location //userspace/libc:variant_headers)/include"]
        # The patcher only emits the headers it changes, so the source copies
        # stay on the path behind the variant ones - the role the SDK's
        # /usr/include plays upstream (e.g. _locale.h includes the unpatched
        # _locale_posix2008.h). sys/cdefs.h chains through include_next.
        flags += ["-Iuserspace/libc/include"]
    else:
        flags += ["-Iuserspace/libc/include"]
    if archive == "FreeBSD" or archive in LIBC_VARIANT_FLAGS:
        # fbsdcompat carries a FreeBSD-era sys/cdefs.h (guard _SYS_CDEFS_H_)
        # that defines neither __BEGIN_DECLS nor __FBSDID, and a sys/endian.h.
        # Searched before the libc include directory it shadows the Darwin
        # cdefs that the installed sys headers (bsd/sys/*.h) need, so it comes
        # after it: <sys/cdefs.h> chains through the libc wrapper to
        # bsd/sys/cdefs.h, while port_before.h/reentrant.h/namespace.h and
        # machine/atomic.h still come from fbsdcompat.
        flags += ["-Iuserspace/libc/fbsdcompat"]
    flags += LIBC_INCLUDE_FLAGS
    flags += LIBC_VARIANT_FLAGS.get(archive, [])
    return [(source, flags + source_flags) for source, source_flags in LIBC_ARCHIVE_SOURCES[archive]]

