load(":sources.bzl", "LIBC_ARCHIVES", "LIBC_BASE_FLAGS", "LIBC_HEADERS", "LIBC_INCLUDE_FLAGS", "LIBC_PUBLIC_HEADER_INPUTS", "libc_sources")

# macosx/arm64 normal, resolved from the upstream Xcode project and xcconfigs.
# These are native archives, not a claimed libsystem_c.dylib runtime closure.
# Normal arc4random.c requires the unavailable corecrypto/ccrng.h and corecrypto
# runtime. Preserve that dependency rather than stub it or remove its consumer.
# CrashReporterClient.h and dirhelper_priv.h are optional in the upstream code.

genrule(
    name = "libc_features",
    srcs = [
        "xcodescripts/generate_features.pl",
        "Platforms/macosx/Makefile.inc",
    ],
    out = "libc_features",
    cmd = "ARCHS=arm64 VARIANT_PLATFORM_NAME=macosx " +
          "SRCROOT=\"$SRCDIR\" DERIVED_FILES_DIR=\"$OUT\" " +
          "perl \"$SRCDIR/xcodescripts/generate_features.pl\"",
    default_target_platform = "//platforms:host",
    visibility = ["PUBLIC"],
)

# Xcode patches the installed private libc headers for the LIBC_ALIAS_* source
# flags. Here those real public header inputs are available in the source tree.
# The upstream patcher is used unchanged; no proprietary SDK is needed.
genrule(
    name = "variant_headers",
    srcs = LIBC_PUBLIC_HEADER_INPUTS + ["xcodescripts/patch_headers_variants.pl"],
    out = "variant_headers",
    cmd = "mkdir -p \"$OUT\" && " +
          "perl \"$SRCDIR/xcodescripts/patch_headers_variants.pl\" \"$SRCDIR/include\" \"$OUT\"",
    default_target_platform = "//platforms:host",
    visibility = ["PUBLIC"],
)

