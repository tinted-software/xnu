        # Libinfo's private and installed headers (libinfo_common.h, od_debug.h,
        # ils.h, membership.h, ...) and the <rpc/>, <rpcsvc/> root come before
        # the libc include dirs, so they are the ones these sources see.
        "-Iuserspace/libinfo/Libinfo",
        "-Iuserspace/libinfo/lookup.subproj",
        "-Iuserspace/libinfo/membership.subproj",
        "-Iuserspace/libinfo/gen.subproj",
        "-Iuserspace/libinfo/nis.subproj",
        "-I$(location :libinfo_rpc_include)",
        # <bootstrap_priv.h> (liblaunch, installed to /usr/local/include).
        "-Iuserspace/launchd/liblaunch",
        # Xcode GCC_PREPROCESSOR_DEFINITIONS (Libinfo.xcconfig, macosx). DEBUG is
        # the Release value: this is the normal, non-debug archive.
        "-DDEBUG=0",
        "-D__MigTypeCheck=1",
        "-DINET6=1",
        "-DCONFIG_MAC",
        "-DDARWIN_DIRECTORY_AVAILABLE",
        "-DDS_AVAILABLE",
        "-DSYNTH_ROOTFS",
        # The SDK's stdio/stdlib/... come from the libc public headers, as in
        # libc_sources(): -nostdlibinc is set, so this root must be present.
        "-Iuserspace/libc/include",
        # rpc.subproj still has K&R definitions (pmap_prot.c, authunix_prot.c);
        # Apple's compiler accepted them under GCC_TREAT_WARNINGS_AS_ERRORS.
        "-Wno-error=deprecated-non-prototype",
    ] + LIBC_BASE_FLAGS + LIBC_INCLUDE_FLAGS,
    lang_compiler_flags = {
        "c": ["-include", "$(location //userspace/AvailabilityVersions:headers)/Availability.h"],
    },
    deps = [
        ":libinfo_rpc_include",
        "//userspace/AvailabilityVersions:headers",
        "//:userspace_generated",
        "//userspace/libc:libc_features",
        "//userspace:system_headers",
    ],
    preferred_linkage = "static",
    link_style = "static_pic",
    link_whole = True,
    default_target_platform = "//platforms:aarch64-darwin",
    visibility = ["PUBLIC"],
)
