# Apple Libinfo (libsystem_info): Libinfo.xcodeproj's libsystem_info Sources
# phase (107 files; nis.subproj/getnetgrent.c is not in the target) with
# Libinfo.xcconfig's macosx definitions (CONFIG_MAC DARWIN_DIRECTORY_AVAILABLE
# DS_AVAILABLE SYNTH_ROOTFS). NOT YET BUILDABLE: the headers below are neither
# in this tree nor in apple-oss-distributions, or need host tools not present:
#   xpc/xpc.h, xpc/private.h (libxpc; unguarded in gen.subproj/configuration_profile.c)
#   opendirectory/odipc.h, opendirectory/DSlibinfoMIG_types.h (DSlibinfoMIG.defs unpublished)
#   DarwinDirectory/RecordStore_priv.h (unpublished)
#   rpcsvc/yp.h, rpcsvc/yppasswd.h (rpcgen of Librpcsvc/yp.x; no rpcgen on host)
# Published upstream but not yet vendored: dns_sd.h, dns_sd_private.h (mDNSResponder),
# nameser.h (Libresolv), os/feature_private.h (//userspace/featureflags:headers),
# dispatch/private.h (libdispatch private/).

load("//userspace/libc:sources.bzl", "LIBC_BASE_FLAGS", "LIBC_INCLUDE_FLAGS")

# Xcode installs rpc.subproj headers as <rpc/*.h> and nis.subproj's
# yp_prot.h/ypclnt.h as <rpcsvc/*.h> (xcodescripts/install_files.sh). Lay out
# the same include root so the sources' <rpc/...> and <rpcsvc/...> resolve.
genrule(
    name = "libinfo_rpc_include",
    srcs = glob(["rpc.subproj/*.h"]) + ["nis.subproj/yp_prot.h", "nis.subproj/ypclnt.h"],
    out = "include",
    cmd = "set -e\n" +
          "mkdir -p $OUT/rpc $OUT/rpcsvc\n" +
          "cp rpc.subproj/*.h $OUT/rpc/\n" +
          "cp nis.subproj/yp_prot.h nis.subproj/ypclnt.h $OUT/rpcsvc/\n",
    default_target_platform = "//platforms:host",
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "libinfo_objects",
