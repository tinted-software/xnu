load("//userspace/libc:sources.bzl", "LIBC_BASE_FLAGS", "LIBC_INCLUDE_FLAGS")

# libsystem_asl (syslog.xcodeproj target "libsystem_asl") as a static archive.
# Client-side MIG only: asl_ipc.defs has no Server attribute in that target.

_PLATFORM = "//platforms:aarch64-darwin"

# Apple's osfmk/mach tree as the MIG include root (same as liblaunch's MIG run).
_MIG_BASE = "-novouchers -I$(location //:launchd_mig_mach_defs)"

genrule(
    name = "asl_ipc_mig",
    srcs = ["aslcommon/asl_ipc.defs", "//:launchd_mig_mach_defs"],
    outs = {
        "user": ["asl_ipcUser.c"],
        "header": ["asl_ipc.h"],
    },
    cmd = "set -e\n" +
          "MIG=$(exe //tools/migcom:mig)\n" +
          "$MIG " + _MIG_BASE + " -target arm64-apple-macos27.0.0 -user $OUT/asl_ipcUser.c -header $OUT/asl_ipc.h -server /dev/null -sheader /dev/null aslcommon/asl_ipc.defs\n",
    default_target_platform = _PLATFORM,
    visibility = ["PUBLIC"],
)

cxx_library(
    name = "libasl_objects",
    srcs = [
        "libsystem_asl.tproj/src/asl.c",
        "libsystem_asl.tproj/src/asl_client.c",
        "libsystem_asl.tproj/src/asl_core.c",
        "libsystem_asl.tproj/src/asl_fd.c",
        "libsystem_asl.tproj/src/asl_file.c",
        "libsystem_asl.tproj/src/asl_legacy1.c",
        "libsystem_asl.tproj/src/asl_mt_shim.c",
        "libsystem_asl.tproj/src/asl_msg.c",
        "libsystem_asl.tproj/src/asl_msg_list.c",
        "libsystem_asl.tproj/src/asl_object.c",
        "libsystem_asl.tproj/src/asl_store.c",
        "libsystem_asl.tproj/src/asl_string.c",
        "libsystem_asl.tproj/src/asl_util.c",
        "libsystem_asl.tproj/src/syslog.c",
        ":asl_ipc_mig[user]",
    ],
    headers = {
        "asl_ipc.h": ":asl_ipc_mig[header]",
    },
    header_namespace = "",
    deps = [
        "//:userspace_generated",
        "//:system_framework_headers",
        "//userspace:system_headers",
        "//userspace/AvailabilityVersions:headers",
        "//userspace/libc:libc_features",
    ],
    compiler_flags = [
        "-include", "EXTERNAL_HEADERS/xros_availability_aliases.h",
    ] + LIBC_BASE_FLAGS + LIBC_INCLUDE_FLAGS + [
        "-Iuserspace/libc/include",
        "-Ibsd",
        "-Iosfmk",
        "-Ilibkern",
        "-Iuserspace/syslog/libsystem_asl.tproj/include",
        "-Iuserspace/launchd/liblaunch",
    ],
    lang_compiler_flags = {
        "c": ["-include", "$(location //userspace/AvailabilityVersions:headers)/Availability.h"],
    },
    preferred_linkage = "static",
    link_style = "static_pic",
    link_whole = True,
    default_target_platform = _PLATFORM,
    visibility = ["PUBLIC"],
)
