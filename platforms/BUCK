# Platform definitions for multi-target builds in XNU

platform(
    name = "host",
    constraint_values = [
        "prelude//cpu/constraints:arm64",
        "prelude//os/constraints:macos",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "aarch64-none",
    constraint_values = [
        "prelude//cpu/constraints:arm64",
        "toolchains//:none",
    ],
    visibility = ["PUBLIC"],
)

platform(
    name = "aarch64-darwin",
    constraint_values = [
        "prelude//cpu/constraints:arm64",
        "prelude//os/constraints:macos",
        "toolchains//:xnu",
    ],
    visibility = ["PUBLIC"],
)
