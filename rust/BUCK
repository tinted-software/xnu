        "//third-party/rust:hadris-apfs",
        "//third-party/rust:hadris-fs",
        "//third-party/rust:hadris-io",
        "//third-party/rust:hadris-storage",
        "//third-party/rust:md-5",
        "//third-party/rust:poly1305",
        "//third-party/rust:sha1",
        "//third-party/rust:sha2",
        "//third-party/rust:subtle",
    ],
    default_target_platform = "//platforms:aarch64-darwin",
    visibility = ["PUBLIC"],
)
