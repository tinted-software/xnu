diff --git a/clang/lib/Sema/SemaType.cpp b/clang/lib/Sema/SemaType.cpp
index 1cb96b556..78081718f 100644
--- a/clang/lib/Sema/SemaType.cpp
+++ b/clang/lib/Sema/SemaType.cpp
@@ -8706,8 +8706,8 @@ static void HandleNeonVectorTypeAttr(QualType &CurType, const ParsedAttr &Attr,
 static void HandlePtrAuthQualifier(ASTContext &Ctx, QualType &T,
                                    const ParsedAttr &Attr, Sema &S) {
 
-  assert((Attr.getNumArgs() > 0 && Attr.getNumArgs() <= 3) &&
-         "__ptrauth qualifier takes between 1 and 3 arguments");
+  assert((Attr.getNumArgs() > 0 && Attr.getNumArgs() <= 4) &&
+         "__ptrauth qualifier takes between 1 and 4 arguments");
   Expr *KeyArg = Attr.getArgAsExpr(0);
   Expr *IsAddressDiscriminatedArg =
       Attr.getNumArgs() >= 2 ? Attr.getArgAsExpr(1) : nullptr;
@@ -8754,10 +8754,58 @@ static void HandlePtrAuthQualifier(ASTContext &Ctx, QualType &T,
 
   assert((!IsAddressDiscriminatedArg || IsAddressDiscriminated <= 1) &&
          "address discriminator arg should be either 0 or 1");
+  PointerAuthenticationMode AuthMode = PointerAuthenticationMode::SignAndAuth;
+  bool IsIsaPointer = false;
+  bool AuthenticatesNullValues = false;
+  if (Attr.getNumArgs() >= 4) {
+    // The optional options string: a comma-separated list of 'isa-pointer',
+    // 'authenticates-null-values' and at most one authentication mode.
+    const auto *Opts =
+        dyn_cast<StringLiteral>(Attr.getArgAsExpr(3)->IgnoreParenImpCasts());
+    if (!Opts || !Opts->isOrdinary()) {
+      S.Diag(Attr.getLoc(), diag::err_ptrauth_options_not_string);
+      Attr.setInvalid();
+      return;
+    }
+    SmallVector<StringRef, 4> Parts;
+    Opts->getString().split(Parts, ',', /*MaxSplit=*/-1, /*KeepEmpty=*/false);
+    bool HasMode = false;
+    for (StringRef Part : Parts) {
+      Part = Part.trim();
+      if (Part.empty())
+        continue;
+      std::optional<PointerAuthenticationMode> Mode;
+      if (Part == "isa-pointer") {
+        IsIsaPointer = true;
+        continue;
+      }
+      if (Part == "authenticates-null-values") {
+        AuthenticatesNullValues = true;
+        continue;
+      }
+      if (Part == "strip")
+        Mode = PointerAuthenticationMode::Strip;
+      else if (Part == "sign-and-strip")
+        Mode = PointerAuthenticationMode::SignAndStrip;
+      else if (Part == "sign-and-auth")
+        Mode = PointerAuthenticationMode::SignAndAuth;
+      else {
+        S.Diag(Attr.getLoc(), diag::err_ptrauth_option_invalid) << Part;
+        Attr.setInvalid();
+        return;
+      }
+      if (HasMode) {
+        S.Diag(Attr.getLoc(), diag::err_ptrauth_option_conflict) << Part;
+        Attr.setInvalid();
+        return;
+      }
+      HasMode = true;
+      AuthMode = *Mode;
+    }
+  }
   PointerAuthQualifier Qual = PointerAuthQualifier::Create(
-      Key, IsAddressDiscriminated, ExtraDiscriminator,
-      PointerAuthenticationMode::SignAndAuth, /*IsIsaPointer=*/false,
-      /*AuthenticatesNullValues=*/false);
+      Key, IsAddressDiscriminated, ExtraDiscriminator, AuthMode, IsIsaPointer,
+      AuthenticatesNullValues);
   T = S.Context.getPointerAuthType(T, Qual);
 }
 
